[
  {
    "siteName": "Chase",
    "urlRegex": "https://secure\\.chase\\.com/web/auth/dashboard#/dashboard/summary/[0-9]+/CARD/BAC",
    "selectors": {
      "accountName": ".nav-bar__print-header",
      "rewardsContainer": "[id$=\"Rewards-dataItem\"]",
      "rewardsLabel": [
        "[data-testid=\"dataItem-label\"] mds-definition-link::attr(definition-text)",
        "[data-testid=\"dataItem-label\"]"
      ],
      "rewardsValue": "[data-testid=\"dataItem-value\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "\\.\\.\\.",
        "replace": ""
      },
      "programName": {
        "pattern": "® points",
        "replace": ""
      }
    }
  },
  {
    "siteName": "Amex",
    "urlRegex": "https://global\\.americanexpress\\.com/dashboard\\?account_key=[A-Z0-9]+",
    "selectors": {
      "accountName": "[data-testid=\"simple_switcher_display_label\"]",
      "rewardsContainer": "[data-module-name=\"axp-loyalty-points\"]",
      "rewardsLabel": "[data-locator-id=\"membership_rewards_title\"]",
      "rewardsValue": "[data-locator-id=\"membership_rewards_title_value\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Amex (.*)® Card••••(\\d+)",
        "replace": "$1 ($2)"
      },
      "programName": {
        "pattern": "® points",
        "replace": ""
      }
    }
  },
  {
    "siteName": "World of Hyatt",
    "urlRegex": "https://www.hyatt.com/profile/",
    "selectors": {
      "accountName": "[data-locator=\"member-number\"]",
      "rewardsContainer": "[class^=\"MemberCard_content\"]",
      "rewardsLabel": "[class^=\"MemberCard_tierLabel\"]",
      "rewardsValue": "[data-locator=\"points-balance\"]"
    }
  },
  {
    "siteName": "IHG",
    "urlRegex": "https://www.ihg.com/rewardsclub/[a-z]+/[a-z]+/account-mgmt/home",
    "selectors": {
      "accountName": "[data-testid=\"memberNumberSID\"]",
      "rewardsContainer": "app-ihg-header .container",
      "rewardsLabel": "[data-testid=\"memberLevelNameSID\"]",
      "rewardsValue": "[data-testid=\"pointsToRedeemSID\"]"
    },
    "normalizations": {
      "programName": {
        "transform": "titlecase"
      }
    }
  },
  {
    "siteName": "Hilton Honors",
    "urlRegex": "https://www.hilton.com/[a-z]+/hilton-honors/guest/my-account/",
    "selectors": {
      "accountName": "[data-testid=\"honorsNumberBlock\"]",
      "rewardsContainer": "[data-testid=\"memberInfoBlock\"]",
      "rewardsLabel": "[data-testid=\"tierBlock\"] > div:first-of-type",
      "rewardsValue": "[data-testid=\"honorsPointsBlock\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Hilton Honors # ",
        "replace": ""
      }
    }
  }
]
