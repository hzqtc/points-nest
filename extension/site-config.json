[
  {
    "siteName": "Chase",
    "category": "Bank",
    "icon": "https://www.chase.com/favicon.ico",
    "urlRegex": "https://secure\\.chase\\.com/web/auth/dashboard#/dashboard/summary/[0-9]+/CARD/BAC",
    "selectors": {
      "accountName": ".nav-bar__print-header",
      "accountId": ".nav-bar__print-header",
      "programName": [
        "[id$=\"Rewards-dataItem\"] [data-testid=\"dataItem-label\"] mds-definition-link::attr(definition-text)",
        "[id$=\"Rewards-dataItem\"] [data-testid=\"dataItem-label\"]"
      ],
      "rewardsValue": "[id$=\"Rewards-dataItem\"] [data-testid=\"dataItem-value\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "\\s*\\(\\.\\.\\.\\d+\\)",
        "replace": ""
      },
      "accountId": {
        "pattern": ".*\\(\\.\\.\\.(\\d+)\\)",
        "replace": "$1"
      },
      "programName": {
        "pattern": "®? [pP]oints",
        "replace": ""
      }
    }
  },
  {
    "siteName": "Amex",
    "category": "Bank",
    "icon": "https://www.americanexpress.com/favicon.ico",
    "urlRegex": "https://global\\.americanexpress\\.com/dashboard\\?account_key=[A-Z0-9]+",
    "selectors": {
      "accountName": "[data-testid=\"simple_switcher_display_label\"]",
      "accountId": "[data-testid=\"simple_switcher_display_label\"]",
      "programName": "[data-locator-id=\"membership_rewards_title\"]",
      "rewardsValue": "[data-locator-id=\"membership_rewards_title_value\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Amex (.*)® Card••••(\\d+)",
        "replace": "$1"
      },
      "accountId": {
        "pattern": ".*••••(\\d+)",
        "replace": "$1"
      },
      "programName": {
        "pattern": "® points",
        "replace": ""
      }
    }
  },
  {
    "siteName": "World of Hyatt",
    "category": "Hotel",
    "icon": "https://www.hyatt.com/favicon.ico",
    "urlRegex": "https://www.hyatt.com/profile/",
    "selectors": {
      "accountName": "[data-locator=\"name\"]",
      "accountId": "[data-locator=\"member-number\"]",
      "programName": "[class^=\"MemberCard_tierLabel\"]",
      "rewardsValue": "[data-locator=\"points-balance\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "^(?:Mr|Mrs|Ms|Miss|Dr|Prof)\\.?\\s+([^\\s]+).*",
        "replace": "$1",
        "transform": "titlecase"
      }
    }
  },
  {
    "siteName": "IHG One",
    "category": "Hotel",
    "icon": "https://www.ihg.com/favicon.ico",
    "urlRegex": "https://www.ihg.com/rewardsclub/[a-z]+/[a-z]+/account-mgmt/home",
    "selectors": {
      "accountName": "[data-testid=\"memberNameSID\"]",
      "accountId": "[data-testid=\"memberNumberSID\"]",
      "programName": "[data-testid=\"memberLevelNameSID\"]",
      "rewardsValue": "[data-testid=\"pointsToRedeemSID\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Hello (.+),",
        "replace": "$1"
      },
      "programName": {
        "transform": "titlecase"
      }
    }
  },
  {
    "siteName": "Hilton Honors",
    "category": "Hotel",
    "icon": "https://www.hilton.com/favicon.ico",
    "urlRegex": "https://www.hilton.com/[a-z]+/hilton-honors/guest/my-account/",
    "selectors": {
      "accountName": "[data-testid=\"firstNameLabel\"]",
      "accountId": "[data-testid=\"honorsNumberBlock\"]",
      "programName": "[data-testid=\"tierBlock\"] > div:first-of-type",
      "rewardsValue": "[data-testid=\"honorsPointsBlock\"]"
    },
    "normalizations": {
      "accountId": {
        "pattern": "Hilton Honors # ",
        "replace": ""
      }
    }
  },
  {
    "siteName": "Marriott Bonvoy",
    "category": "Hotel",
    "icon": "https://www.marriott.com/favicon.ico",
    "urlRegex": "https://www.marriott.com/loyalty/myAccount/default.mi",
    "selectors": {
      "accountName": ".member-status-v3__profile-details [data-testid=\"ui-library-Heading\"]",
      "accountId": "[data-testid=\"membersnapshotribbon-v2\"] .card__header [data-testid=\"ui-library-Text\"]",
      "programName": "[data-testid=\"membersnapshotribbon-v2\"] .card__header [data-testid=\"ui-library-Heading\"]",
      "rewardsValue": "[data-testid=\"account-WalletWidget\"] .points_wrapper span.t-title-s"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Hi, ([^\\s]+).*",
        "replace": "$1"
      }
    }
  },
  {
    "siteName": "Alaska Atmos",
    "category": "Airline",
    "icon": "https://www.alaskaair.com/favicon.ico",
    "urlRegex": "https://www.alaskaair.com/atmosrewards/account/overview/",
    "selectors": {
      "accountName": ".member-info .display-name",
      "accountId": ".guest-information-container > .member-info >.info-row:nth-of-type(2)",
      "programName": ".guest-information-container > .member-info >.info-row:first-of-type",
      "rewardsValue": ".available-points-container .points-value"
    },
    "normalizations": {
      "accountName": {
        "pattern": "^([^\\s]+).*",
        "replace": "$1",
        "transform": "titlecase"
      },
      "accountId": {
        "pattern": "Rewards No. ",
        "replace": ""
      },
      "programName": {
        "pattern": "Atmos™ ",
        "replace": ""
      }
    }
  },
  {
    "siteName": "Delta Skymiles",
    "category": "Airline",
    "icon": "https://www.delta.com/favicon.ico",
    "urlRegex": [
      "https://www.delta.com/myskymiles",
      "https://www.delta.com/my-trips",
      "https://www.delta.com/my-profile"
    ],
    "selectors": {
      "accountName": ".skymiles-medallion-banner .skymiles-medallion-banner__details__container__left__title > div:nth-of-type(2)",
      "accountId": ".skymiles-medallion-banner .skymiles-medallion-banner__details__container__right__skymiles-wrapper:first-of-type .skymiles-medallion-banner__details__container__right__skymiles-wrapper__subtitle",
      "programName": ".skymiles-medallion-banner .skymiles-medallion-banner__status__container__tier__wrapper__subtitle",
      "rewardsValue": ".skymiles-medallion-banner .skymiles-medallion-banner__details__container__right__skymiles-wrapper:nth-of-type(2) .skymiles-medallion-banner__details__container__right__skymiles-wrapper__subtitle"
    },
    "normalizations": {
      "programName": {
        "pattern": "SKYMILES® ",
        "replace": ""
      }
    }
  },
  {
    "siteName": "United MileagePlus",
    "category": "Airline",
    "icon": "https://www.united.com/favicon.ico",
    "urlRegex": "https://www.united.com/[a-z]+/[a-z]+/myunited",
    "selectors": {
      "accountName": "[class*=\"app-components-Navigation-styles__navigationContainer\"] .atm-c-box-section__header",
      "accountId": "[class*=\"app-components-MyUnited-AccountSummaryDetails-AccountSummary-accountSummary__mpNumber\"]",
      "programName": "[class*=\"app-components-MyUnited-AccountSummaryDetails-Badge\"]::attr(aria-label)",
      "rewardsValue": "[class*=\"app-components-MyUnited-AccountSummaryDetails-MileageBalance-MileageBalance__totalMiles\"]"
    },
    "normalizations": {
      "accountName": {
        "pattern": "Hello, ",
        "replace": ""
      },
      "accountId": {
        "pattern": "MileagePlus Number",
        "replace": ""
      },
      "programName": {
        "pattern": " Badge",
        "replace": ""
      }
    }
  }
]
