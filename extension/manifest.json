{
  "manifest_version": 3,
  "name": "Points Nest (Secure & Local)",
  "version": "1.0.0",
  "description": "Securely and locally aggregates your credit card points balances.",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16-active.png",
    "32": "icon32-active.png",
    "48": "icon48-active.png",
    "128": "icon128-active.png"
  },
  "host_permissions": [
    "https://secure.chase.com/*",
    "https://global.americanexpress.com/*",
    "https://www.hyatt.com/*",
    "https://www.ihg.com/*",
    "https://www.hilton.com/*",
    "https://www.marriott.com/*",
    "https://www.alaskaair.com/*",
    "https://www.delta.com/*",
    "https://www.united.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Points Nest",
    "default_icon": {
      "16": "icon16-inactive.png",
      "32": "icon32-inactive.png",
      "48": "icon48-inactive.png",
      "128": "icon128-inactive.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://secure.chase.com/*",
        "https://global.americanexpress.com/*",
        "https://www.hyatt.com/*",
        "https://www.ihg.com/*",
        "https://www.hilton.com/*",
        "https://www.marriott.com/*",
        "https://www.alaskaair.com/*",
        "https://www.delta.com/*",
        "https://www.united.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["site-config.json", "constants.json"],
      "matches": [
        "https://secure.chase.com/*",
        "https://global.americanexpress.com/*",
        "https://www.hyatt.com/*",
        "https://www.ihg.com/*",
        "https://www.hilton.com/*",
        "https://www.marriott.com/*",
        "https://www.alaskaair.com/*",
        "https://www.delta.com/*",
        "https://www.united.com/*"
      ]
    }
  ]
}
